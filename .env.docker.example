# Enterprise Performance Engine - Docker Environment Variables

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_NAME=epe
DATABASE_USER=epe_user
DATABASE_PASSWORD=change_me_in_production_strong_password_123
DATABASE_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password_456

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================
# Anthropic Claude API Key (for AI content generation)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI API Key (for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# PINECONE VECTOR DATABASE
# =============================================================================
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=epe-lessons

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production

# API Configuration
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Admin Dashboard Configuration
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise Performance Engine
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_AI_GENERATION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
